# Environment paths
typeset -U PATH path fpath
fpath=("$HOME/.zfunc" "${fpath[@]}")
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" "$HOME/.cargo/bin" "${path[@]}")

# History configuration
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_VERIFY
setopt SHARE_HISTORY

# Directory options
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'

# History substring search keybindings
bindkeyHistorySubstringSearch() {
  if [[ "$OSTYPE" == "linux-gnu" ]]; then
    bindkey '^[OA' history-substring-search-up
    bindkey '^[OB' history-substring-search-down
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
  fi
  HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
}
bindkeyHistorySubstringSearch

# Automatically run by zsh-vi-mode after init
function zvm_after_init() {
  bindkeyHistorySubstringSearch
  command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh 2>/dev/null)"
}

# Antidote plugin loading with static caching (loads plugins & updates fpath before compinit)
zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins.txt
zsh_plugins_cache=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh
if [[ ! -f $zsh_plugins_cache || $zsh_plugins -nt $zsh_plugins_cache ]]; then
  [[ -d ~/.antidote ]] || git clone --depth=1 https://github.com/mattmc3/antidote.git ~/.antidote
  source ~/.antidote/antidote.zsh
  antidote bundle < "$zsh_plugins" > "$zsh_plugins_cache"
  zcompile "$zsh_plugins_cache" 2>/dev/null || true
fi
[[ -f $zsh_plugins_cache ]] && source "$zsh_plugins_cache"

# Fast compinit with daily cache check
setopt EXTENDED_GLOB
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"
  zcompile "${ZDOTDIR:-$HOME}/.zcompdump" 2>/dev/null || true
else
  compinit -C -d "${ZDOTDIR:-$HOME}/.zcompdump"
fi

# Starship prompt (cached for speed)
if [[ -f $HOME/.theme.zsh ]]; then
  source "$HOME/.theme.zsh"
elif command -v starship >/dev/null 2>&1; then
  if [[ -z $STARSHIP_CONFIG ]]; then
    if [[ -f $HOME/.config/starship.local.toml ]]; then
      export STARSHIP_CONFIG="$HOME/.config/starship.local.toml"
    else
      typeset _os_flavor=""
      if [[ "$OSTYPE" == darwin* ]]; then
        _os_flavor="mac"
      elif [[ -r /etc/os-release ]]; then
        typeset _os_info="$(</etc/os-release)"
        if [[ "$_os_info" == *omarchy* || "$_os_info" == *ID=arch* || "$_os_info" == *ID_LIKE=*arch* ]]; then
          _os_flavor="omarchy"
        elif [[ "$_os_info" == *ubuntu* ]]; then
          _os_flavor="ubuntu"
        fi
      fi

      if [[ -n $_os_flavor && -f $HOME/.config/starship.$_os_flavor.toml ]]; then
        export STARSHIP_CONFIG="$HOME/.config/starship.$_os_flavor.toml"
      else
        export STARSHIP_CONFIG="$HOME/.config/starship.toml"
      fi
    fi
  fi
  starship_cache="${XDG_CACHE_HOME:-$HOME/.cache}/starship-init.zsh"
  if [[ ! -f $starship_cache || $STARSHIP_CONFIG -nt $starship_cache ]]; then
    mkdir -p "${starship_cache:h}"
    starship init zsh > "$starship_cache"
  fi
  [[ -f $starship_cache ]] && source "$starship_cache"
fi

# Tool integrations (cached for speed)
if command -v zoxide >/dev/null 2>&1; then
  zoxide_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zoxide-init.zsh"
  zoxide_bin="$(command -v zoxide)"
  if [[ ! -f $zoxide_cache || $zoxide_bin -nt $zoxide_cache ]]; then
    mkdir -p "${zoxide_cache:h}"
    zoxide init zsh > "$zoxide_cache"
  fi
  [[ -f $zoxide_cache ]] && source "$zoxide_cache"
fi

# Completion styling
zstyle ':completion:*:*:git*:*' ignored-patterns '*ORIG_HEAD'
zstyle ':completion:*:make::' tag-order 'targets'
zstyle ':completion:*:make:*:targets' group-name targets

# Common environment & aliases
source ~/.shrc

# gcloud completion
if command -v gcloud >/dev/null 2>&1 && [ -f ~/dev/dotfiles/config/gcloud/completion.zsh.inc ]; then
  source ~/dev/dotfiles/config/gcloud/completion.zsh.inc
fi

# Shell-GPT integration ZSH v0.2
_sgpt_zsh() {
  if [[ -n "$BUFFER" ]]; then
    _sgpt_prev_cmd=$BUFFER
    BUFFER+="⌛"
    zle -I && zle redisplay
    BUFFER=$(sgpt --shell <<< "$_sgpt_prev_cmd" --no-interaction)
    zle end-of-line
  fi
}
zle -N _sgpt_zsh

bindkey -M emacs '^O' _sgpt_zsh
bindkey -M vicmd '^O' _sgpt_zsh
bindkey -M viins '^O' _sgpt_zsh
