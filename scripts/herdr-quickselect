#!/usr/bin/env python3
"""
herdr-quickselect: Fast, fzf-powered QuickSelect for Herdr.
Extracts URLs, file paths, git hashes, and IP addresses from the active pane
and presents them in an interactive fzf picker for fast clipboard copying.
"""

import json
import os
import re
import shutil
import subprocess
import sys

LOG_FILE = "/tmp/herdr-quickselect.log"


def log(msg: str):
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"{msg}\n")
    except Exception:
        pass


def find_bin(name: str, fallbacks: list[str]) -> str:
    found = shutil.which(name)
    if found:
        return found
    for fb in fallbacks:
        if os.path.exists(fb):
            return fb
    return name


HERDR_BIN = find_bin("herdr", [
    os.path.expanduser("~/.local/share/mise/installs/herdr/latest/herdr"),
])

FZF_BIN = find_bin("fzf", [
    os.path.expanduser("~/.local/share/mise/installs/fzf/latest/fzf"),
])


def read_pane(pid: str) -> str:
    for source in ["recent-unwrapped", "visible", "recent"]:
        try:
            out = subprocess.check_output(
                [HERDR_BIN, "pane", "read", pid, "--source", source, "--lines", "150"],
                stderr=subprocess.DEVNULL,
                timeout=2.0,
            ).decode("utf-8", errors="ignore")
            if out.strip():
                return out
        except Exception:
            pass
    return ""


def get_target_pane_and_content(own_pane_id: str | None) -> tuple[str | None, str]:
    # 1. Query herdr pane list (returns JSON directly, do NOT pass --json)
    try:
        out = subprocess.check_output([HERDR_BIN, "pane", "list"], stderr=subprocess.DEVNULL, timeout=2.0).decode("utf-8")
        data = json.loads(out)
        panes = data.get("result", {}).get("panes", [])
        log(f"Herdr panes found: {len(panes)}")

        # First priority: focused pane that has actual content
        for p in panes:
            pid = p.get("pane_id")
            if p.get("focused"):
                content = read_pane(pid)
                if content:
                    log(f"Found focused pane with content: {pid} ({len(content)} bytes)")
                    return pid, content

        # Second priority: any pane that is not the popup pane and has content
        for p in panes:
            pid = p.get("pane_id")
            if pid != own_pane_id:
                content = read_pane(pid)
                if content:
                    log(f"Found candidate pane with content: {pid} ({len(content)} bytes)")
                    return pid, content
    except Exception as e:
        log(f"Error querying herdr pane list: {e}")

    # 2. Query herdr pane current
    try:
        out = subprocess.check_output([HERDR_BIN, "pane", "current"], stderr=subprocess.DEVNULL, timeout=2.0).decode("utf-8")
        data = json.loads(out)
        cur = data.get("result", {}).get("pane", {}).get("pane_id")
        if cur:
            content = read_pane(cur)
            if content:
                log(f"Found pane current with content: {cur} ({len(content)} bytes)")
                return cur, content
    except Exception as e:
        log(f"Error querying herdr pane current: {e}")

    # 3. Last fallback: try own_pane_id if provided
    if own_pane_id:
        content = read_pane(own_pane_id)
        if content:
            log(f"Fallback to own_pane_id: {own_pane_id} ({len(content)} bytes)")
            return own_pane_id, content

    return None, ""


def extract_matches(text: str) -> list[str]:
    patterns = [
        # URLs (http/https/ftp)
        r"https?://[^\s\"'`<>()\[\]{}]+",
        # Git SSH clone URLs
        r"git@[a-zA-Z0-9._-]+:[a-zA-Z0-9._/-]+",
        # Absolute Unix paths
        r"/(?:[a-zA-Z0-9_.-]+/)+[a-zA-Z0-9_.-]*",
        # Relative paths starting with ~ or .
        r"(?:~|\.\.|\.)/(?:[a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+",
        # Common source tree paths without leading slash (e.g. config/herdr/config.toml, src/main.rs)
        r"\b(?:[a-zA-Z0-9_.-]+/)+[a-zA-Z0-9_.-]+\b",
        # Filenames with extensions
        r"\b[a-zA-Z0-9_.-]+\.(?:sh|py|js|ts|jsx|tsx|json|toml|yaml|yml|md|rs|go|lua|conf|txt|log|zsh|bash|c|cpp|h|hpp|html|css|sql|env)\b",
        # Git commit hashes (7 to 40 hex chars)
        r"\b[0-9a-f]{7,40}\b",
        # IPv4 addresses
        r"\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b",
        # UUIDs
        r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b",
    ]

    combined = re.compile("|".join(f"({p})" for p in patterns))

    lines = text.splitlines()
    matches_reverse: list[str] = []
    seen: set[str] = set()

    for line in reversed(lines):
        for m in combined.finditer(line):
            token = m.group(0).strip().rstrip(".,:;)]}\"'`>")
            token = token.lstrip("<(\"'`")
            if token and len(token) >= 3 and token not in seen:
                if token.isdigit() and len(token) < 4:
                    continue
                seen.add(token)
                matches_reverse.append(token)

    return matches_reverse


def copy_to_clipboard(text: str):
    log(f"Copying to clipboard: {text}")
    # 1. macOS native pbcopy
    pbcopy_bin = shutil.which("pbcopy") or "/usr/bin/pbcopy"
    if os.path.exists(pbcopy_bin):
        try:
            p = subprocess.Popen([pbcopy_bin], stdin=subprocess.PIPE)
            p.communicate(text.encode("utf-8"))
        except Exception as e:
            log(f"pbcopy error: {e}")

    # 2. OSC 52 sequence for remote SSH
    try:
        import base64
        b64 = base64.b64encode(text.encode("utf-8")).decode("ascii")
        osc52 = f"\x1b]52;c;{b64}\x07"
        sys.stderr.write(osc52)
        sys.stderr.flush()
    except Exception:
        pass


def notify_herdr(copied_text: str):
    preview = copied_text if len(copied_text) <= 40 else copied_text[:37] + "..."
    try:
        subprocess.run(
            [HERDR_BIN, "notification", "show", "QuickSelect", "--body", f"Copied: {preview}", "--position", "bottom-right"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1.0,
        )
    except Exception as e:
        log(f"notify error: {e}")


def run_fzf(candidates: list[str]) -> tuple[list[str], str]:
    if not candidates:
        return [], ""

    input_bytes = "\n".join(candidates).encode("utf-8")

    cmd = [
        FZF_BIN,
        "--multi",
        "--reverse",
        "--prompt=QuickSelect ❯ ",
        "--pointer=❯",
        "--header=[Enter] Copy  [Tab] Select Multiple  [Ctrl-O] Open  [Esc] Cancel",
        "--expect=ctrl-o",
    ]

    log(f"Running fzf with {len(candidates)} candidates: {cmd}")

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
        )
        stdout, _ = proc.communicate(input=input_bytes)
    except Exception as e:
        log(f"fzf error: {e}")
        return [], ""

    if proc.returncode != 0 and proc.returncode != 1:
        log(f"fzf non-zero returncode: {proc.returncode}")
        return [], ""

    lines = stdout.decode("utf-8", errors="ignore").splitlines()
    if not lines:
        log("fzf returned no lines")
        return [], ""

    key = lines[0]
    selections = lines[1:]
    log(f"fzf selected {len(selections)} items (key={key})")

    return selections, key


def main():
    log("=== QuickSelect invoked ===")
    own_id = os.environ.get("HERDR_PANE_ID")
    log(f"HERDR_PANE_ID in env: {own_id}")

    pane_id, content = get_target_pane_and_content(own_id)
    if not pane_id or not content:
        log("No target pane or content could be found")
        print("QuickSelect: No terminal content found in pane", file=sys.stderr)
        sys.exit(1)

    candidates = extract_matches(content)
    log(f"Extracted {len(candidates)} candidates")
    if not candidates:
        log("No candidates found in content")
        print("QuickSelect: No URLs, paths, or tokens found on screen", file=sys.stderr)
        sys.exit(0)

    selections, key = run_fzf(candidates)
    if not selections:
        log("No selection made; exiting")
        sys.exit(0)

    joined = " ".join(selections) if len(selections) > 1 else selections[0]

    if key == "ctrl-o":
        for item in selections:
            try:
                subprocess.run(["open", item], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                log(f"open error: {e}")
    else:
        copy_to_clipboard(joined)
        notify_herdr(joined)

    log("QuickSelect finished successfully")


if __name__ == "__main__":
    main()
